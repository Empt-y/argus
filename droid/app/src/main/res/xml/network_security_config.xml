<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere except the development loopback.

  This used to permit cleartext to anything, with the trade-off written down
  honestly: traffic to a LAN or tailnet address was protected by the network
  boundary and a bearer token rather than by transport encryption. That is a
  weaker claim than HTTPS and it is no longer necessary.

  `tailscale serve` now terminates TLS for https://athena.tail1f65b0.ts.net with
  a real certificate and proxies to argusd on loopback, so the address a phone
  actually uses — on the LAN, on mobile data, anywhere — is HTTPS. The blanket
  allowance bought nothing except the ability to misconfigure the app into
  sending a device token in the clear.

  What remains permitted is the two addresses that only ever mean "this
  machine, during development":

    127.0.0.1  — `adb reverse tcp:8787 tcp:8787` over USB
    10.0.2.2   — the emulator's alias for its host

  Neither leaves the device. Any other host, including a plain http:// LAN
  address, is now refused by the platform rather than by a code review.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
