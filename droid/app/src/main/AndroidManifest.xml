<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The alert watcher is a foreground service: it holds a WebSocket to the
      daemon so that a geofence the user drew still reaches them after they have
      closed the map. `dataSync` is the honest type for "keeping a connection to
      the user's own server open"; there is no push provider involved and there
      will not be one, since routing a notification about the user's own
      airspace through a third party to come back to their own phone is not
      something this project is willing to do.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="Argus"
        android:supportsRtl="true"
        android:theme="@style/Theme.Argus">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The pairing QR argusd prints on its console is a link:
              argus://pair?server=<url>&code=<code>. Claiming the scheme means
              the phone's own camera app opens it here with both fields filled
              in, so pairing needs no camera permission and no QR library in
              this app. singleTask above is what routes a scan into the running
              instance rather than starting a second one over the map.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="argus" android:host="pair" />
            </intent-filter>
        </activity>

        <service
            android:name=".AlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
